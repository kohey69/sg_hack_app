%h2 基本情報編集
= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f|
  .form-inputs
    = f.input :plan_id, collection: Plan.published.default_order, prompt: "登録プランを選択してください"
    = f.input :delivery_schedule_type
    = f.input :name
    = f.input :email, required: true
    = f.input :password, hint: '変更しない場合は空欄のままにしてください', required: false
    = f.input :password_confirmation, required: false
    = f.input :current_password, hint: '情報を変更する場合には入力が必要です', required: true
  .fw-bolder 配送先
  .form-inputs
    = f.input :postal_code
    = f.input :prefecture
    = f.input :city
    = f.input :address_line1
    = f.input :address_line2
    = f.input :phone_number
  .form-actions.mb-3
    = f.button :submit
